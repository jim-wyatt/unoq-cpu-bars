{
  // Deliberately minimal - this board has 3.6 GiB of RAM shared with the
  // Zephyr build. Every extension here earns its place; see docs/maintenance.md.
  "recommendations": [
    "llvm-vs-code-extensions.vscode-clangd",
    "marus25.cortex-debug",
    "kylemicallefbonnici.dts-lsp",
    "charliermarsh.ruff",
    "ms-python.python",
    "ms-python.debugpy"
  ],
  // Pylance was removed (~412 MB even in "light" mode); Ruff's LSP replaces it.
  // The C/C++ extension would fight clangd for IntelliSense.
  "unwantedRecommendations": [
    "ms-python.vscode-pylance",
    "ms-vscode.cpptools"
  ]
}
