[Unit]
Description=Bind the Arduino UNO Q USB gadget to the controller that just appeared
Documentation=file:/home/arduino/two-computers-one-board/docs/reference/usb.md

# Started by udev (99-unoq-usb-gadget.rules) when a UDC or a gadget netdev
# appears - that is, when someone plugs the board into a computer.
Requires=unoq-usb-gadget.service
After=unoq-usb-gadget.service

# Let the network come up FIRST, every boot, before touching USB.
#
# On a board powered over the same cable that carries the gadget, the UDC is
# present seconds into every boot, so this unit runs on every boot rather than
# only when someone plugs a cable in. Binding re-enumerates the port, and if
# that is going to brown the board out, it must not be able to do so before
# there is an ssh session to diagnose it from. Ordering after the network
# guarantees a window in which the board is reachable.
#
# This costs the gadget a few seconds of availability at boot and cannot
# deadlock: wifi does not depend on USB, and NetworkManager-wait-online times
# out on its own if there is no network to wait for.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# usb-net-up.sh leaves two long-lived daemons behind it - udhcpc, and
# avahi-autoipd when no DHCP server answers - and with the default
# KillMode=control-group systemd kills both the instant this oneshot finishes.
# They are children in its cgroup, and a oneshot without RemainAfterExit goes
# inactive the moment ExecStart returns, which tears that cgroup down:
#
#   avahi-autoipd(br-usb): Starting with address 169.254.13.209
#   avahi-autoipd(br-usb): Got SIGTERM, quitting.
#   unoq-usb-bind.service: Deactivated successfully.
#
# So the board came out of every hot re-plug with no DHCP client running at all.
# That went unnoticed for as long as it did because the bridge also carried a
# static 10.55.0.1: the board stayed reachable whether or not udhcpc lived, and
# nothing pointed at the unit. Deleting that address is what made it visible.
#
# Note this never affected boot, only re-plugs. At boot it is
# unoq-usb-gadget.service that runs usb-net-up.sh, and that one IS
# RemainAfterExit=yes - it stays active, so its cgroup survives and so do its
# children. Same script, opposite outcome, decided entirely by which unit
# happened to invoke it.
#
# KillMode=process kills only the main ExecStart process and leaves the rest,
# which is what a unit whose job is to *start* things needs. Tearing the daemons
# down is gadget-down.sh's job, from unoq-usb-gadget.service's ExecStop.
KillMode=process

EnvironmentFile=-/etc/default/unoq-usb

# Deliberately NOT RemainAfterExit. This unit has to be able to run again on
# every plug-in, and systemd will not re-run ExecStart for a oneshot it still
# considers active - which is exactly the trap unoq-usb-gadget.service falls
# into, and why the binding lives here rather than there.
# Refuses once the board has tried and failed to survive a bind several times
# over, which is the only thing that stops a brownout loop being permanent.
# See bind-guard.sh for why that loop has no ssh window in it.
ExecStartPre=/home/arduino/two-computers-one-board/usb/bind-guard.sh check

ExecStart=/home/arduino/two-computers-one-board/usb/gadget-up.sh
ExecStart=/home/arduino/two-computers-one-board/usb/usb-net-up.sh

# No ExecStop: unbinding is unoq-usb-gadget.service's job, so that pulling the
# cable (which removes the UDC and stops this unit) does not tear down the
# gadget definition we want to keep for the next plug-in.
